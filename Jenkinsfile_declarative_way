pipeline{

    agent any
    triggers {
        githubPush()
        
    }

    options {
  buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '', daysToKeepStr: '5', numToKeepStr: '5')
  timestamps()
}
stages {
    stage('Checkout-git') {
        steps {
            git branch: 'dev', credentialsId: '42236ddd-abc2-4855-bdb7-b28ef614cc83', url: 'https://github.com/Saiteja043/Maven-Web-Application_test.git'
            
        }
    }
    stage('Maven Build') {
        steps {
            bat "mvn clean package"
            
        }
        
    }
    stage('SonarQube Report') {
  steps {
      bat "mvn clean sonar:sonar"
  }
        
    }
    stage('Nexus Upload') {
        steps {
            bat "mvn clean deploy"
            
        }
        
    }
    stage('Deploy into Tomcat') {
  steps {
    deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: '123e7593-a14f-432c-bd4f-5da94a1037c5', path: '', url: 'http://98.130.98.202:8888/')], contextPath: 'Jenkins_Deploy_Declarative_way', war: '**/maven-web-application.war'
  }
        
    }


 
}
